# Released/research artifacts are byte-addressed. Preserve their published bytes
# even when Windows core.autocrlf is enabled; do not normalize before hashing.
explorer/public/*.json -text
research/development-race/** -text
research/position-evidence/*.json -text

# Keep frozen comparison hashes stable on Windows.
research/model-comparison/REGISTRATION.md text eol=lf
research/model-comparison/**/*.json -text
research/model-comparison/**/*.jsonl -text
research/model-comparison/**/*.gz -text
research/model-comparison/**/*.xz -text
pipeline/comparison*.py text eol=lf
pipeline/development.py text eol=lf
research/model-comparison/provenance/*.bundle -text

# Keep issue57 execution and feature-attestation hashes portable on Windows.
pipeline/*.py text eol=lf
research/race-context/** -text

# Preserve hypothesis registration and execution evidence bytes.
research/hypotheses/** -text
